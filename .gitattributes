# Los archivos de Docker van siempre con saltos de linea LF (un CRLF ensucia los diffs y rompe scripts de
# shell dentro de la imagen). El resto sigue la configuracion de cada PC (core.autocrlf).
Dockerfile text eol=lf
.dockerignore text eol=lf
docker-compose.yml text eol=lf
docker/** text eol=lf
# La referencia pdoc de docs/dev/api/ se genera con scripts/build_dev_docs.py: siempre LF (las huellas del
# manifiesto no dependen del sistema, pero un CRLF ensuciaria el diff) y GitHub la trata como generada.
docs/dev/api/** text eol=lf linguist-generated=true -diff
