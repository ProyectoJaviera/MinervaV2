# Minerva - plantilla de variables de entorno.
# Copia este archivo a .env y completa los valores. NUNCA subas .env ni pongas
# credenciales reales en este archivo de ejemplo.

# --- General ---
ENV=development
LOG_LEVEL=INFO
REPORT_TIMEZONE=America/Santiago

# --- Bitunix (solo endpoints publicos de mercado en v1; sin credenciales) ---
BITUNIX_REST_BASE_URL=https://fapi.bitunix.com
BITUNIX_WS_PUBLIC_URL=wss://fapi.bitunix.com/public/
BITUNIX_RATE_LIMIT_PER_SEC=10
# Simbolo(s) usados por la vertical minima de Fase 1 (universo dinamico llega despues)
TRADING_SYMBOLS=BTCUSDT
KLINE_INTERVAL=4h
SCHEDULER_POLL_SECONDS=60
STRATEGY_HISTORY_BARS=100
ACTIVE_STRATEGY=ema_cross_9_21

# --- Comisiones simuladas (VIP0 oficial; ajusta si tu cuenta real tiene otro tier) ---
MAKER_FEE_PCT=0.0002
TAKER_FEE_PCT=0.0006

# --- Capital y tamano de posicion (paper trading) ---
INITIAL_CAPITAL_USDT=100
DEFAULT_MARGIN_USDT=5
LEVERAGE=10
MARGIN_MODE=ISOLATED

# --- Gestion de riesgo ---
MAX_DRAWDOWN_PCT=0.20
MAX_DAILY_LOSS_PCT=0.05
MAX_SIMULTANEOUS_POSITIONS=3
MAX_CAPITAL_PCT_PER_ASSET=0.10
CONSECUTIVE_LOSSES_CIRCUIT_BREAKER=4
CIRCUIT_BREAKER_COOLDOWN_HOURS=8
# Cupo de posiciones abiertas en la MISMA direccion (LONG o SHORT), sin importar el simbolo
MAX_SAME_DIRECTION_POSITIONS=2
# Tope de perdida del SL sobre el margen para operaciones EN VIVO -- PORCENTAJE 0-100 (50.0 = 50%)
LIVE_SL_MARGIN_CAP_PCT=50.0
# Modo del stop por drawdown: "duro" (detiene entradas nuevas, reanudacion manual) o "alerta" (solo notifica)
DRAWDOWN_STOP_MODE=duro
# Vigencia de datos: funding obsoleto = ultimo evento mas viejo que el intervalo del contrato + este margen (horas)
FUNDING_STALE_MARGIN_HOURS=1
# Vela obsoleta = la ultima vela cerrada cerro hace mas de un intervalo + esta tolerancia (segundos)
CANDLE_STALE_TOLERANCE_SECONDS=300
# Monitor de posiciones (subfase 3.4)
# Sin latido del WebSocket publico durante estos segundos no se abren entradas (nunca bloquea cierres)
WS_STALE_AFTER_SECONDS=45
# Un TP solo se rellena al precio observado si el tick lo supera por mas de esta FRACCION (hueco evidente)
TP_GAP_TOLERANCE_PCT=0.002
# Sin ticks de un simbolo con posicion abierta durante estos segundos: alerta y consulta el precio por REST
TICK_STALE_SECONDS=60
# Cada cuanto el monitor refresca marcas, funding, equity y estado (segundos)
MONITOR_TICK_SECONDS=15
# Sin LLM (hasta la subfase 3.6) las aperturas automaticas en la cuenta real estan desactivadas
AUTO_OPEN_WITHOUT_LLM=false
# Estrategias habilitadas para la cuenta real (paper) -- lista separada por comas, vacio = todas elegibles
REAL_ACCOUNT_ELIGIBLE_STRATEGIES=ema_cross_9_21,funding_contrarian_experimental,funding_contrarian_percentile_experimental

# --- Criterios para evaluar paso a dinero real (informativos, no automaticos) ---
MIN_PAPER_TRADING_DAYS=30
MIN_CLOSED_TRADES=100
MIN_PROFIT_FACTOR=1.3

# --- CoinGecko (Fase 2+: universo dinamico top-10). Clave gratuita, igual se trata como credencial ---
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# --- Claude / Anthropic (Fase 3.6: decision del LLM sobre señales) ---
ANTHROPIC_API_KEY=
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5
ANTHROPIC_SONNET_MODEL=claude-sonnet-5-5
LLM_DAILY_BUDGET_USD=1.0
CONFLUENCE_SCORE_THRESHOLD=0.6

# --- Telegram (Fase 5: notificaciones y comandos) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Frontend / API (Fase 5: autenticacion local de un solo usuario) ---
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
JWT_SECRET=

# --- Base de datos ---
DATABASE_PATH=./data/minerva.db
