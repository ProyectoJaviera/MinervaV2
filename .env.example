# Minerva - plantilla de variables de entorno.
# Copia este archivo a .env y completa los valores. NUNCA subas .env ni pongas
# credenciales reales en este archivo de ejemplo.

# --- General ---
ENV=development
LOG_LEVEL=INFO
REPORT_TIMEZONE=America/Santiago

# --- Bitunix (solo endpoints publicos de mercado en v1; sin credenciales) ---
BITUNIX_REST_BASE_URL=https://fapi.bitunix.com
BITUNIX_WS_PUBLIC_URL=wss://fapi.bitunix.com/public/
BITUNIX_RATE_LIMIT_PER_SEC=10
# Simbolo(s) usados por la vertical minima de Fase 1 (universo dinamico llega despues)
TRADING_SYMBOLS=BTCUSDT
KLINE_INTERVAL=4h
SCHEDULER_POLL_SECONDS=60
STRATEGY_HISTORY_BARS=100
ACTIVE_STRATEGY=ema_cross_9_21

# --- Comisiones simuladas (VIP0 oficial; ajusta si tu cuenta real tiene otro tier) ---
MAKER_FEE_PCT=0.0002
TAKER_FEE_PCT=0.0006

# --- Capital y tamano de posicion (paper trading) ---
INITIAL_CAPITAL_USDT=100
DEFAULT_MARGIN_USDT=10
LEVERAGE=10
MARGIN_MODE=ISOLATED

# --- Gestion de riesgo ---
MAX_DRAWDOWN_PCT=0.20
MAX_DAILY_LOSS_PCT=0.05
MAX_SIMULTANEOUS_POSITIONS=3
MAX_CAPITAL_PCT_PER_ASSET=0.10
CONSECUTIVE_LOSSES_CIRCUIT_BREAKER=4
CIRCUIT_BREAKER_COOLDOWN_HOURS=8

# --- Criterios para evaluar paso a dinero real (informativos, no automaticos) ---
MIN_PAPER_TRADING_DAYS=30
MIN_CLOSED_TRADES=100
MIN_PROFIT_FACTOR=1.3

# --- CoinGecko (Fase 2+: universo dinamico top-10). Clave gratuita, igual se trata como credencial ---
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# --- Claude / Anthropic (Fase 4: motor de decision y sentimiento de noticias) ---
ANTHROPIC_API_KEY=
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5
ANTHROPIC_SONNET_MODEL=claude-sonnet-5
LLM_DAILY_BUDGET_USD=1.0
CONFLUENCE_SCORE_THRESHOLD=0.6

# --- Telegram (Fase 5: notificaciones y comandos) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Frontend / API (Fase 5: autenticacion local de un solo usuario) ---
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
JWT_SECRET=

# --- Base de datos ---
DATABASE_PATH=./data/minerva.db
