# Minerva - plantilla de variables de entorno.
# Copia este archivo a .env y completa los valores. NUNCA subas .env ni pongas
# credenciales reales en este archivo de ejemplo.

# --- General ---
ENV=development
LOG_LEVEL=INFO
REPORT_TIMEZONE=America/Santiago
LOG_DIR=logs
HEARTBEAT_SECONDS=300

# --- Bitunix (solo endpoints publicos de mercado en v1; sin credenciales) ---
BITUNIX_REST_BASE_URL=https://fapi.bitunix.com
BITUNIX_WS_PUBLIC_URL=wss://fapi.bitunix.com/public/
BITUNIX_RATE_LIMIT_PER_SEC=10
# Cada cuantos segundos el scheduler busca velas cerradas nuevas para evaluar las estrategias
SCHEDULER_POLL_SECONDS=60

# --- Comisiones simuladas (VIP0 oficial; ajusta si tu cuenta real tiene otro tier) ---
MAKER_FEE_PCT=0.0002
TAKER_FEE_PCT=0.0006

# --- Capital y tamano de posicion (paper trading) ---
INITIAL_CAPITAL_USDT=100
DEFAULT_MARGIN_USDT=5
LEVERAGE=10

# --- Gestion de riesgo ---
MAX_DRAWDOWN_PCT=0.20
MAX_DAILY_LOSS_PCT=0.05
MAX_SIMULTANEOUS_POSITIONS=3
MAX_CAPITAL_PCT_PER_ASSET=0.10
CONSECUTIVE_LOSSES_CIRCUIT_BREAKER=4
CIRCUIT_BREAKER_COOLDOWN_HOURS=8
# Cupo de posiciones abiertas en la MISMA direccion (LONG o SHORT), sin importar el simbolo
MAX_SAME_DIRECTION_POSITIONS=2
# Tope de perdida del SL sobre el margen para operaciones EN VIVO -- PORCENTAJE 0-100 (50.0 = 50%)
LIVE_SL_MARGIN_CAP_PCT=50.0
# Modo del stop por drawdown: "duro" (detiene entradas nuevas, reanudacion manual) o "alerta" (solo notifica)
DRAWDOWN_STOP_MODE=duro
# Vigencia de datos: funding obsoleto = ultimo evento mas viejo que el intervalo del contrato + este margen (horas)
FUNDING_STALE_MARGIN_HOURS=1
# Vela obsoleta = la ultima vela cerrada cerro hace mas de un intervalo + esta tolerancia (segundos)
CANDLE_STALE_TOLERANCE_SECONDS=300
# Monitor de posiciones (subfase 3.4)
# Sin latido del WebSocket publico durante estos segundos no se abren entradas (nunca bloquea cierres)
WS_STALE_AFTER_SECONDS=45
# Un TP solo se rellena al precio observado si el tick lo supera por mas de esta FRACCION (hueco evidente)
TP_GAP_TOLERANCE_PCT=0.002
# Sin ticks de un simbolo con posicion abierta durante estos segundos: alerta y consulta el precio por REST
TICK_STALE_SECONDS=60
# Cada cuanto el monitor refresca marcas, funding, equity y estado (segundos)
MONITOR_TICK_SECONDS=15
# Sin LLM (hasta la subfase 3.6) las aperturas automaticas en la cuenta real estan desactivadas
AUTO_OPEN_WITHOUT_LLM=false
# Estrategias habilitadas para la cuenta real (paper) -- lista separada por comas, vacio = todas elegibles
REAL_ACCOUNT_ELIGIBLE_STRATEGIES=ema_cross_9_21,funding_contrarian_experimental,funding_contrarian_percentile_experimental

# --- Criterios para evaluar paso a dinero real (informativos, no automaticos) ---
MIN_PAPER_TRADING_DAYS=30
MIN_CLOSED_TRADES=100
MIN_PROFIT_FACTOR=1.3

# --- CoinGecko (Fase 2+: universo dinamico top-10). Clave gratuita, igual se trata como credencial ---
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# --- Universo dinamico (Fase 2): top N por capitalizacion con perpetuo USDT en Bitunix ---
UNIVERSE_SIZE=10
# Cuantos candidatos se piden a CoinGecko antes de filtrar stablecoins, envueltos, etc.
UNIVERSE_CANDIDATE_POOL=30
UNIVERSE_REFRESH_HOURS=24
# Un universo mas viejo que esto no genera senales nuevas hasta el proximo refresco (los cierres siguen)
UNIVERSE_STALENESS_HOURS=48
UNIVERSE_EXCLUDE_CATEGORIES=stablecoins,wrapped-tokens,liquid-staking-tokens
# Ids de CoinGecko (no simbolos) a excluir a mano, separados por comas
UNIVERSE_MANUAL_EXCLUSIONS=
# FRACCION 0-1: si el precio de CoinGecko y el de Bitunix difieren mas que esto, el activo no entra (0.05 = 5%)
UNIVERSE_PRICE_SANITY_TOLERANCE_PCT=0.05

# --- Backtesting (Fase 2; los resultados vigentes se corrieron con estos valores) ---
BACKTEST_INITIAL_CAPITAL=100
BACKTEST_SLIPPAGE_BPS=5
BACKTEST_MIN_TRADES_PER_CELL=30
BACKTEST_MIN_TRADES_TOTAL=100
BACKTEST_MIN_PROFIT_FACTOR=1.2
# FRACCION 0-1 (0.50 = 50%)
BACKTEST_MAX_DRAWDOWN_PCT=0.50
BACKTEST_CONCENTRATION_LIMIT_PCT=0.40
BACKTEST_MIN_PCT_SYMBOLS_PF_GT1=0.50
BACKTEST_MIN_PCT_FOLDS_POSITIVE=0.50
BACKTEST_STRESS_FEE_MULTIPLIER=2
BACKTEST_STRESS_SLIPPAGE_MULTIPLIER=2
BACKTEST_OOS_SPLIT_PCT=0.30
BACKTEST_WALK_FORWARD_FOLD_MONTHS=6
BACKTEST_WALK_FORWARD_STEP_MONTHS=2
BACKTEST_CONTROL_SYMBOLS=BTCUSDT,ETHUSDT
# PORCENTAJE 0-100 (50.0 = 50%, NO 0.50): una entrada cuyo SL perderia mas de esto del margen se omite
MAX_SL_MARGIN_LOSS_PCT=50.0
# SL/TP de respaldo como FRACCION 0-1 de movimiento de precio (0.05 = 5%) para estrategias sin niveles propios
BACKTEST_FALLBACK_SL_PCT=0.05
BACKTEST_FALLBACK_TP_PCT=0.10
# Corridas Monte Carlo de la simulacion de cartera (informativa)
BACKTEST_PORTFOLIO_SIM_RUNS=200
# Fecha final FIJA (UTC) del backtest oficial: dos corridas dan exactamente los mismos numeros
BACKTEST_OFFICIAL_END_DATE=2026-10-01

# --- Claude / Anthropic (Fase 3.6: decision del LLM sobre señales) ---
ANTHROPIC_API_KEY=
# Modelo que etiqueta la medicion: NO cambiarlo mientras dure (el hash congelado no lo cubre).
ANTHROPIC_SONNET_MODEL=claude-sonnet-5-5
# Tope diario con corte duro (dia en REPORT_TIMEZONE). Es lo unico que cuesta dinero.
LLM_DAILY_BUDGET_USD=1.0
LLM_MAX_TOKENS=300
LLM_TIMEOUT_SECONDS=20
LLM_MAX_CONCURRENCY=4
LLM_REAL_MAX_DELAY_SECONDS=60
LLM_PRICE_INPUT_PER_MTOK=2.0
LLM_PRICE_OUTPUT_PER_MTOK=10.0
# Etiquetado en vivo de sombras durante la medicion (TAREA B): apagado por
# defecto a proposito. NO activar sin decision explicita del usuario.
LLM_LIVE_LABELING_ENABLED=false
# Brazo ejecutado de la cuenta PAPER (subfase 3.9): abre solo las senales APROBADA a tiempo.
# Apagado por defecto; start_bot.ps1 lo activa solo para el puerto 8000. Nunca abre dinero real.
PAPER_EXECUTION_ENABLED=false
# Fase 4 (docs/FASE4_PLAN.md), fuera del prompt congelado de la medicion. Recoleccion de noticias
# (aislada, gratuita, sin costo de Anthropic): apagada por defecto; start_bot.ps1 la activa solo
# para el puerto 8000. Fuentes verificadas: gdelt, fed_monetary, fear_greed.
NEWS_COLLECTION_ENABLED=false
NEWS_SOURCES=gdelt,fed_monetary,fear_greed
NEWS_RETENTION_DAYS=180
# Identificacion ante las fuentes (sin datos personales) y tope del tamano de cada respuesta
NEWS_USER_AGENT=MinervaPaperBot/1.0 (personal paper-trading research, non-commercial)
NEWS_MAX_RESPONSE_BYTES=2000000
# Memoria de lecciones (solo operaciones cerradas; nunca muestra PnL antes del registro oficial
# del veredicto): apagada; no se activa durante la medicion.
LESSONS_MEMORY_ENABLED=false
LESSONS_MIN_SAMPLE=30
LESSONS_REBUILD_HOURS=24
LESSONS_TOP_K=3

# --- Telegram (Fase 5: notificaciones y comandos) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Bot de comandos por long-polling (subfase 3.7): apagado por defecto. Un token solo
# admite UN consumidor de getUpdates; start_bot.ps1 lo activa solo para el puerto 8000.
TELEGRAM_COMMANDS_ENABLED=false
# Fase 5 (docs/FASE5_PLAN.md): notificaciones push al chat permitido (posicion abierta/cerrada,
# cambio de universo, alertas de riesgo). Apagado por defecto y aislado; start_bot.ps1 lo activa solo
# para el puerto 8000. Necesita TELEGRAM_BOT_TOKEN y TELEGRAM_CHAT_ID.
TELEGRAM_PUSH_ENABLED=false
TELEGRAM_PUSH_POLL_SECONDS=10

# --- Frontend / API (Fase 5: autenticacion local de un solo usuario) ---
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
JWT_SECRET=
# Controles del dashboard (pausar, reanudar, kill switch; piden confirmacion y quedan auditados).
# Poner false para que la API rechace esas acciones (403) sin tocar codigo.
DASHBOARD_CONTROLS_ENABLED=true

# --- Base de datos ---
DATABASE_PATH=./data/minerva.db
